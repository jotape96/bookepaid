// BookepAId — Prisma schema (originated fresh against an intentionally-empty
// Supabase Postgres project; see frontend/IMPLEMENTATION_STAGES.md S1 notes).
//
// Table/column names are mapped back to snake_case (@map/@@map) to match the
// naming convention `backend/` (Python/Streamlit, supabase-py) expects, since
// backend/ keeps writing to these same tables with raw dict keys and must
// never be touched or broken by this migration.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Matches the lowercase string values backend/models.py writes/reads for
/// users.role ("owner" | "manager").
enum UserRole {
  OWNER   @map("owner")
  MANAGER @map("manager")

  @@map("user_role")
}

/// Matches the exact-case string values Claude's extraction prompt in
/// backend/invoice.py asks for and backend/app.py filters on.
enum LineItemCategory {
  COGS      @map("COGS")
  PACKAGING @map("Packaging")
  LABOUR    @map("Labour")
  OVERHEAD  @map("Overhead")
  OTHER     @map("Other")

  @@map("line_item_category")
}

/// New — drives the async invoice-processing job (§B.4 of the implementation
/// plan). No legacy data to match, so plain enum labels are fine.
enum InvoiceJobSourceType {
  INVOICE
  MENU_ONBOARDING

  @@map("invoice_job_source_type")
}

enum InvoiceJobStatus {
  PENDING
  PROCESSING
  DONE
  FAILED

  @@map("invoice_job_status")
}

// ---------------------------------------------------------------------------
// Core business tables (originated fresh, 1:1 with what backend/ expects)
// ---------------------------------------------------------------------------

model Business {
  id   String @id @default(uuid()) @db.Uuid
  name String
  type String

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  users        User[]
  invoices     Invoice[]
  lineItems    LineItem[]
  plates       Plate[]
  plateHistory PlateHistory[]
  invoiceJobs  InvoiceJob[]

  @@map("businesses")
}

model User {
  id    String   @id @default(uuid()) @db.Uuid
  name  String
  email String   @unique
  role  UserRole

  /// Legacy SHA-256 password hash (backend/models.py `_hash_password`).
  /// Read-only from the new app's perspective — never written by Next.js;
  /// kept only so backend/ keeps working unmodified and for audit history.
  password String?

  /// New — bcrypt hash used by the NextAuth Credentials provider. Nullable
  /// until the user completes a forced password reset (see mustResetPassword).
  passwordHash String? @map("password_hash")

  /// New — forces every pre-existing user through a password-reset flow
  /// before they can log in with the new app. Defaults true so newly
  /// introspected/legacy rows are safe by default; set false once reset.
  mustResetPassword Boolean @default(true) @map("must_reset_password")

  businessId String   @map("business_id") @db.Uuid
  business   Business @relation(fields: [businessId], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  passwordResetTokens PasswordResetToken[]
  createdInvoiceJobs  InvoiceJob[]

  @@map("users")
}

model Invoice {
  id            String   @id @default(uuid()) @db.Uuid
  businessId    String   @map("business_id") @db.Uuid
  business      Business @relation(fields: [businessId], references: [id])
  invoiceNumber String   @map("invoice_number")
  supplier      String
  /// Date-only per backend/data.py's `str(date)[:10]` truncation.
  date          DateTime @db.Date
  filename      String

  /// New — Supabase Storage location of the uploaded source file (not
  /// persisted today).
  storagePath   String? @map("storage_path")
  storageBucket String? @map("storage_bucket")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  lineItems   LineItem[]
  invoiceJobs InvoiceJob[]

  @@map("invoices")
}

model LineItem {
  id          String           @id @default(uuid()) @db.Uuid
  invoiceId   String           @map("invoice_id") @db.Uuid
  invoice     Invoice          @relation(fields: [invoiceId], references: [id])
  businessId  String           @map("business_id") @db.Uuid
  business    Business         @relation(fields: [businessId], references: [id])
  description String
  quantity    Decimal          @db.Decimal(12, 4)
  unit        String
  unitPrice   Decimal          @map("unit_price") @db.Decimal(12, 4)
  total       Decimal          @db.Decimal(12, 2)
  category    LineItemCategory
  /// Date-only per backend/data.py's `str(row.get("date",""))[:10]` truncation.
  date        DateTime         @db.Date

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("line_items")
}

model Plate {
  id           String   @id @default(uuid()) @db.Uuid
  businessId   String   @map("business_id") @db.Uuid
  business     Business @relation(fields: [businessId], references: [id])
  name         String
  sellingPrice Decimal  @default(0) @map("selling_price") @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  ingredients  Ingredient[]
  plateHistory PlateHistory[]

  @@map("plates")
}

model Ingredient {
  id          String  @id @default(uuid()) @db.Uuid
  plateId     String  @map("plate_id") @db.Uuid
  plate       Plate   @relation(fields: [plateId], references: [id])
  description String
  quantityKg  Decimal @map("quantity_kg") @db.Decimal(12, 4)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("ingredients")
}

model PlateHistory {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  business   Business @relation(fields: [businessId], references: [id])
  plateId    String   @map("plate_id") @db.Uuid
  plate      Plate    @relation(fields: [plateId], references: [id])
  /// Denormalized snapshot of the plate name at the time of costing —
  /// backend/data.py's snapshot_plate_costs always writes plate["name"].
  plateName  String   @map("plate_name")
  /// Date-only — backend/data.py passes invoice_date (already `[:10]`-truncated).
  date       DateTime @db.Date
  /// backend/data.py always writes `round(result["total_cost"], 4)`.
  cost       Decimal  @db.Decimal(12, 4)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("plate_history")
}

// ---------------------------------------------------------------------------
// New tables (this stage's additive scope)
// ---------------------------------------------------------------------------

model PasswordResetToken {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  /// Never store the raw token — only its hash.
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("password_reset_tokens")
}

/// Drives the async invoice-processing / staged-loading UI (§B.4). The
/// server only tracks these four coarse states — the client fakes
/// finer-grained visual steps against estimatedDurationMs.
model InvoiceJob {
  id String @id @default(uuid()) @db.Uuid

  businessId String   @map("business_id") @db.Uuid
  business   Business @relation(fields: [businessId], references: [id])

  createdById String @map("created_by_id") @db.Uuid
  createdBy   User   @relation(fields: [createdById], references: [id])

  sourceType InvoiceJobSourceType @map("source_type")
  status     InvoiceJobStatus     @default(PENDING)

  storagePath      String @map("storage_path")
  storageBucket    String @map("storage_bucket")
  originalFilename String @map("original_filename")
  mimeType         String @map("mime_type")
  fileSizeBytes    Int    @map("file_size_bytes")

  estimatedDurationMs Int @map("estimated_duration_ms")

  startedAt  DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(6)

  resultJson   Json?   @map("result_json")
  errorMessage String? @map("error_message")

  invoiceId String?  @map("invoice_id") @db.Uuid
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("invoice_jobs")
}
